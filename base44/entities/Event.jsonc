{
  "name": "Event",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "club_slug": {
      "type": "string"
    },
    "club_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "location_name": {
      "type": "string"
    },
    "location_address": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "capacity": {
      "type": "number"
    },
    "rsvp_required": {
      "type": "boolean",
      "default": true
    },
    "is_grant_funded": {
      "type": "boolean",
      "default": false
    },
    "grant_category": {
      "type": "string",
      "enum": [
        "Functions",
        "Camps",
        "Excursions",
        "General"
      ]
    },
    "grant_amount_cents": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "cancelled",
        "completed"
      ],
      "default": "draft"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancellation_reason": {
      "type": "string"
    },
    "public_slug": {
      "type": "string"
    },
    "qr_token": {
      "type": "string"
    },
    "collect_dietary": {
      "type": "boolean",
      "default": false
    },
    "collect_accessibility": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "club_id",
    "title",
    "starts_at",
    "ends_at",
    "location_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
