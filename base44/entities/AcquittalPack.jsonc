{
  "name": "AcquittalPack",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "total_receipts_cents": {
      "type": "number"
    },
    "attendee_count": {
      "type": "number"
    },
    "photos_count": {
      "type": "number"
    },
    "receipts_count": {
      "type": "number"
    },
    "generated_by_email": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "submitted_to_union": {
      "type": "boolean",
      "default": false
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "pdf_url",
    "version"
  ]
}