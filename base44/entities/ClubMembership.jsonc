{
  "name": "ClubMembership",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "description": "Lowercased email of the member"
    },
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "treasurer",
        "scanner"
      ],
      "default": "scanner"
    },
    "invited_by_email": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "club_id",
    "user_email",
    "role"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
