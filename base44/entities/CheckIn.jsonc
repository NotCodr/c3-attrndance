{
  "name": "CheckIn",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "rsvp_id": {
      "type": "string",
      "description": "Null for walk-ins"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "student_number": {
      "type": "string"
    },
    "course": {
      "type": "string"
    },
    "university_name": {
      "type": "string"
    },
    "checked_in_at": {
      "type": "string",
      "format": "date-time"
    },
    "checked_in_by_email": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "qr_scan",
        "manual_lookup",
        "walk_in_add"
      ],
      "default": "qr_scan"
    }
  },
  "required": [
    "event_id",
    "full_name",
    "checked_in_at",
    "method"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
