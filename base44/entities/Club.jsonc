{
  "name": "Club",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Club name"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe lowercase identifier"
    },
    "university": {
      "type": "string",
      "enum": [
        "unimelb"
      ],
      "default": "unimelb"
    },
    "university_name": {
      "type": "string",
      "default": "University of Melbourne"
    },
    "union_name": {
      "type": "string",
      "default": "UMSU"
    },
    "umsu_affiliation_code": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "instagram_handle": {
      "type": "string"
    },
    "primary_contact_email": {
      "type": "string"
    },
    "treasurer_email": {
      "type": "string"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "slug",
    "primary_contact_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
