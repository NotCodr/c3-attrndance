{
  "name": "Club",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe identifier, lowercase, alphanumeric+hyphen"
    },
    "university_slug": {
      "type": "string",
      "default": "unimelb"
    },
    "university_name": {
      "type": "string",
      "default": "University of Melbourne"
    },
    "union_name": {
      "type": "string",
      "default": "UMSU"
    },
    "grant_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Functions",
        "Camps",
        "Excursions",
        "General"
      ]
    },
    "umsu_affiliation_code": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "instagram_handle": {
      "type": "string"
    },
    "primary_contact_email": {
      "type": "string"
    },
    "treasurer_email": {
      "type": "string"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "slug",
    "primary_contact_email"
  ]
}