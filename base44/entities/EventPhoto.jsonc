{
  "name": "EventPhoto",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "display_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "event_id",
    "file_url"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
