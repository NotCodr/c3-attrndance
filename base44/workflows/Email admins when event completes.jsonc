{
  "name": "Email admins when event completes",
  "description": "When an event is marked completed, emails owners and admins a summary (RSVPs, check-ins, show rate, receipts).",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Event"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "email_admins_when_event_completes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendEventCompletionSummary",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendEventCompletionSummary"
  }
}