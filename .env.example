# connect3 frontend configuration.
# Copy to .env.local and fill in from your Supabase project settings.

# Base URL of the connect3 API (the "api" edge function).
#   local:      http://localhost:54321/functions/v1/api
#   production: https://<project-ref>.supabase.co/functions/v1/api
VITE_API_URL=http://localhost:54321/functions/v1/api

# Supabase anon key. Public by design: every table is deny-by-default and this
# key reads nothing on its own. The Functions gateway expects it for routing.
VITE_SUPABASE_ANON_KEY=
